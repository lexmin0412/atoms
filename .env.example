# Another Atoms 环境变量示例：cp .env.example .env 后按需填写
# 「必须」= 不填则启动校验失败（生产环境直接退出）；其余留空会降级对应功能。

# ---------- 平台库（必须）----------
# 存用户 / 项目 / 源码（唯一事实源）/ 消息 / 积分 / 发布记录
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/atoms

# ---------- 应用库（生成的应用用）----------
# 用户项目的业务数据；与平台库分离，每个项目一个 schema + 独立角色（db:init 会自动建角色）
APP_DATABASE_URL=postgres://user:pass@127.0.0.1:5432/atoms_apps
# 已发布应用的后端容器跑在沙箱宿主上，需要指向「从该宿主可达」的数据库地址（留空则退回 APP_DATABASE_URL）
RELEASE_DATABASE_URL=
# 数据库查看器用的只读角色（留空会退回管理连接，只读边界失效）
READONLY_DATABASE_URL=
READONLY_DB_PASSWORD=

# ---------- 模型（必须：API Key）----------
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_API_KEY=
DEFAULT_MODEL=deepseek-v4.1-flash

# ---------- 上下文管理（可选，都有合理默认）----------
# 模型上下文窗口：默认读 models.dev；网关上限更小时用它覆盖
# MODEL_CONTEXT_LIMIT=200000
# 平台软上限：实际发送量超过它的 80% 时自动归纳压缩早期历史
CONTEXT_SOFT_LIMIT=200000
# 单轮对话最长时长（毫秒），到点中止（已完成的改动已落库）
CHAT_MAX_ROUND_MS=900000

# ---------- API ----------
API_PORT=8787
# 生产必须改成随机值（默认值会让会话可被伪造，校验会直接退出）
SESSION_SECRET=change-me-dev-only
# production 时 cookie 带 Secure
NODE_ENV=development

# ---------- 沙箱宿主（数据面）----------
# 控制面通过 SSH 隧道访问；沙箱不暴露公网端口
SANDBOX_URL=http://127.0.0.1:4000
# 控制面与沙箱宿主必须一致
SANDBOX_SHARED_SECRET=change-me-same-on-both-sides

# ---------- 域名与产物托管（发布/预览）----------
# 发布 <id>.<APPS_DOMAIN>、预览 dev-<id>.<APPS_DOMAIN>；留空则不返回绝对地址
APPS_DOMAIN=
# 前端产物托管到对象存储；留空则写本地目录（由 nginx 托管）
COS_BUCKET=
COS_REGION=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ---------- 积分 ----------
# 1 积分 = $0.01，每自然月补满到该额度
CREDITS_MONTHLY_GRANT=500

# ---------- 沙箱宿主侧（在 B 机 .env 里配置）----------
# SANDBOX_PORT=4000
# SANDBOX_HOST=127.0.0.1
# SANDBOX_ROOT=/srv/atoms
# SANDBOX_IMAGE=atoms-sandbox:latest
# SANDBOX_NETWORK=atoms-sandbox
# SANDBOX_MEMORY=1g
# SANDBOX_CPUS=1
# SANDBOX_MAX=4
# SANDBOX_MAX_RELEASES=5
# SANDBOX_IDLE_TTL_MS=1800000
